#!/usr/bin/env bash
# scout — one command to rule the ppscout_ws workspace.
#
#   scout help          list every command
#   scout build         build the workspace from zero (deps included)
#   scout sim           launch the Gazebo simulation
#   scout demo          run the full arm + drive demo
#   scout arm home      send the arm to a named pose
#
# Works from any directory: it always operates on the workspace it lives in,
# and sources ROS + the workspace overlay for you.

set -euo pipefail

# Resolve the workspace root even when invoked through a symlink (scout link).
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
WS_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

ROS_DISTRO_DEFAULT="jazzy"
ROS_SETUP="/opt/ros/${ROS_DISTRO:-$ROS_DISTRO_DEFAULT}/setup.bash"

# ---------------------------------------------------------------- helpers ---

bold()  { printf '\033[1m%s\033[0m' "$1"; }
info()  { printf '\033[1;34m[scout]\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m[scout]\033[0m %s\n' "$*" >&2; }
die()   { printf '\033[1;31m[scout]\033[0m %s\n' "$*" >&2; exit 1; }

source_ros() {
    [ -f "$ROS_SETUP" ] || die "ROS 2 not found at $ROS_SETUP — install it or set ROS_DISTRO."
    # shellcheck disable=SC1090
    set +u; source "$ROS_SETUP"; set -u
}

source_ws() {
    source_ros
    if [ -f "$WS_DIR/install/setup.bash" ]; then
        # shellcheck disable=SC1090
        set +u; source "$WS_DIR/install/setup.bash"; set -u
    else
        die "Workspace not built yet — run 'scout build' first."
    fi
}

# --------------------------------------------------------------- commands ---

cmd_help() {
    cat <<EOF
$(bold "scout — ppscout_ws workspace helper")

Usage: scout <command> [args...]

$(bold "Setup & build")
  deps                Install system dependencies (apt + rosdep). Run once.
  build [args]        Build the workspace (rosdep + colcon --symlink-install).
                      Extra args go to colcon, e.g. scout build --packages-select ppscout_control
  clean               Delete build/ install/ log/ for a from-zero rebuild.
  rebuild             clean + build.
  link                Symlink 'scout' and 'arm' into ~/.local/bin so they work anywhere.

$(bold "Simulation")
  sim [args]          Launch Gazebo + RViz + controllers (ppscout_bringup sim.launch.py).
                      e.g. scout sim rviz:=false enable_arm_controllers:=false
  view                Model viewer only (display.launch.py, no physics).
  demo [args]         Full demo: arm poses + gripper + 1 m square drive.
                      e.g. scout demo --skip-drive --side 0.5

$(bold "Base")
  drive [args]        Timed velocity command, then stop.
                      e.g. scout drive --linear 0.3 --duration 2
  teleop              Keyboard teleop (needs teleop_twist_keyboard).
  stop                Publish a zero velocity to /cmd_vel (emergency-ish stop).

$(bold "Arm & gripper")
  arm <pose>          Move to a named pose: home, ready, reach   (also: arm home)
  arm j1..j6          ...or 6 joint positions in radians, e.g. scout arm -- 0 1 -1 0 0.5 0
  grip open|close|<m> Open/close the gripper or set a position in meters.

$(bold "Pull requests")  (wraps the GitHub CLI; 'main' is protected, so all work lands via PR)
  pr new [title]      Push the current branch and open a PR against main.
  pr branch <name>    Start a fresh branch off an up-to-date main.
  pr list             List open PRs.
  pr view [n]         Show a PR (defaults to the one for the current branch).
  pr checkout <n>     Check out someone else's PR locally.
  pr merge [n]        Squash-merge a PR and delete its branch.
  pr status           PRs waiting on you, and yours waiting on review.

$(bold "Diagnostics")
  status              Workspace/sim health check (build, gazebo, controllers, topics).
  topics              List active ROS topics.
  shell               Open a bash shell with ROS + workspace already sourced.
  help                This message.

Workspace: $WS_DIR
EOF
}

cmd_deps() {
    info "Installing apt packages (sudo required)..."
    sudo apt update
    sudo apt install -y \
        ros-jazzy-desktop ros-jazzy-ros-gz ros-jazzy-gz-ros2-control \
        ros-jazzy-ros2-control ros-jazzy-ros2-controllers \
        ros-jazzy-xacro ros-jazzy-robot-state-publisher \
        ros-jazzy-joint-state-publisher-gui ros-jazzy-rviz2 \
        ros-jazzy-teleop-twist-keyboard \
        python3-colcon-common-extensions python3-rosdep
    if [ ! -d /etc/ros/rosdep/sources.list.d ] || [ -z "$(ls -A /etc/ros/rosdep/sources.list.d 2>/dev/null)" ]; then
        info "Initialising rosdep..."
        sudo rosdep init
    fi
    rosdep update
    info "Dependencies installed. Next: scout build"
}

cmd_build() {
    source_ros
    cd "$WS_DIR"
    if command -v rosdep >/dev/null 2>&1; then
        info "Resolving package dependencies with rosdep..."
        rosdep install --from-paths src --ignore-src -r -y || \
            warn "rosdep reported problems — continuing with the build anyway."
    else
        warn "rosdep not found — skipping dependency resolution (run 'scout deps')."
    fi
    info "Building with colcon (symlink install)..."
    colcon build --symlink-install "$@"
    info "Build done. Try: scout sim"
}

cmd_clean() {
    cd "$WS_DIR"
    info "Removing build/ install/ log/ ..."
    rm -rf build install log
    info "Clean. Run 'scout build' for a fresh build."
}

cmd_link() {
    local bin="$HOME/.local/bin"
    mkdir -p "$bin"
    ln -sf "$WS_DIR/scout" "$bin/scout"
    ln -sf "$WS_DIR/scout" "$bin/arm"
    info "Linked 'scout' and 'arm' into $bin"
    case ":$PATH:" in
        *":$bin:"*) ;;
        *) warn "$bin is not on your PATH — add:  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
    esac
}

cmd_sim()    { source_ws; exec ros2 launch ppscout_bringup sim.launch.py "$@"; }
cmd_view()   { source_ws; exec ros2 launch ppscout_bringup display.launch.py "$@"; }
cmd_demo()   { source_ws; exec ros2 run ppscout_control demo "$@"; }
cmd_drive()  { source_ws; exec ros2 run ppscout_control drive "$@"; }
cmd_arm()    { source_ws; exec ros2 run ppscout_control arm_pose "$@"; }
cmd_grip()   { source_ws; exec ros2 run ppscout_control gripper "$@"; }
cmd_topics() { source_ws; exec ros2 topic list "$@"; }

cmd_teleop() {
    source_ws
    ros2 pkg prefix teleop_twist_keyboard >/dev/null 2>&1 || \
        die "teleop_twist_keyboard not installed — run: sudo apt install ros-jazzy-teleop-twist-keyboard"
    exec ros2 run teleop_twist_keyboard teleop_twist_keyboard
}

cmd_stop() {
    source_ws
    info "Publishing zero velocity to /cmd_vel"
    # -w 0: don't wait for a subscriber to match, publish immediately and exit
    exec ros2 topic pub --once -w 0 /cmd_vel geometry_msgs/msg/Twist '{}'
}

cmd_shell() {
    info "Opening a shell with ROS + workspace sourced (exit to leave)."
    exec bash --init-file <(cat <<EOF
[ -f ~/.bashrc ] && source ~/.bashrc
source "$ROS_SETUP"
source "$WS_DIR/install/setup.bash"
PS1="(scout) \$PS1"
EOF
)
}

cmd_status() {
    printf '%s\n' "$(bold "Workspace") $WS_DIR"
    if [ -f "$WS_DIR/install/setup.bash" ]; then
        echo "  build:        ok (install/ present)"
    else
        echo "  build:        MISSING — run 'scout build'"
        return 0
    fi
    source_ws
    if pgrep -f "gz sim" >/dev/null 2>&1; then
        echo "  gazebo:       running"
    else
        echo "  gazebo:       not running — start with 'scout sim'"
    fi
    local topics
    topics="$(timeout 5 ros2 topic list 2>/dev/null || true)"
    for t in /cmd_vel /odom /joint_states; do
        if grep -qx "$t" <<<"$topics"; then
            echo "  topic $t: ok"
        else
            echo "  topic $t: missing"
        fi
    done
    if grep -q "arm_joint_trajectory_controller" <<<"$(timeout 5 ros2 control list_controllers 2>/dev/null || true)"; then
        echo "  arm ctrl:     loaded"
    else
        echo "  arm ctrl:     not loaded (sim not running, or enable_arm_controllers:=false)"
    fi
}

# ---------------------------------------------------------- pull requests ---

MAIN_BRANCH="main"

require_gh() {
    command -v gh >/dev/null 2>&1 || \
        die "GitHub CLI not found — install it: sudo apt install gh   (see https://cli.github.com)"
    gh auth status >/dev/null 2>&1 || \
        die "GitHub CLI not logged in — run: gh auth login"
}

current_branch() { git -C "$WS_DIR" rev-parse --abbrev-ref HEAD; }

cmd_pr() {
    require_gh
    cd "$WS_DIR"
    local sub="${1:-status}"
    [ $# -gt 0 ] && shift
    case "$sub" in
        new|create)   pr_new "$@" ;;
        branch|start) pr_branch "$@" ;;
        list|ls)      exec gh pr list "$@" ;;
        view|show)    exec gh pr view "$@" ;;
        checkout|co)  [ $# -ge 1 ] || die "Usage: scout pr checkout <number>"
                      exec gh pr checkout "$@" ;;
        merge)        pr_merge "$@" ;;
        status)       exec gh pr status ;;
        *)            die "Unknown pr command '$sub' — see 'scout help'." ;;
    esac
}

pr_branch() {
    [ $# -ge 1 ] || die "Usage: scout pr branch <name>"
    local name="$1"
    git diff --quiet && git diff --cached --quiet || \
        die "You have uncommitted changes — commit or stash them first."
    info "Updating $MAIN_BRANCH..."
    git fetch origin "$MAIN_BRANCH"
    git switch -c "$name" "origin/$MAIN_BRANCH"
    info "On '$name', branched off origin/$MAIN_BRANCH. Commit, then: scout pr new"
}

pr_new() {
    local branch; branch="$(current_branch)"
    [ "$branch" != "$MAIN_BRANCH" ] || \
        die "$MAIN_BRANCH is protected — start a branch first:  scout pr branch <name>"
    git diff --quiet && git diff --cached --quiet || \
        warn "You have uncommitted changes — they will NOT be part of this PR."

    info "Pushing '$branch' to origin..."
    git push -u origin "$branch"

    # --fill takes title and body from the commits on this branch; an explicit
    # --title overrides just the title and leaves the generated body alone.
    if [ $# -gt 0 ]; then
        gh pr create --base "$MAIN_BRANCH" --head "$branch" --fill --title "$*"
    else
        gh pr create --base "$MAIN_BRANCH" --head "$branch" --fill
    fi
    info "main requires 1 approving review — ask a teammate to review before merging."
}

pr_merge() {
    info "Squash-merging (branch is deleted afterwards)..."
    gh pr merge "$@" --squash --delete-branch
    git switch "$MAIN_BRANCH" && git pull --ff-only origin "$MAIN_BRANCH"
}

# --------------------------------------------------------------- dispatch ---

# Invoked as 'arm' (via scout link): behave as 'scout arm ...'
prog="$(basename "$0")"
if [ "$prog" = "arm" ]; then
    set -- arm "$@"
fi

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
    help|-h|--help) cmd_help ;;
    deps|install)   cmd_deps ;;
    build)          cmd_build "$@" ;;
    clean)          cmd_clean ;;
    rebuild)        cmd_clean && cmd_build "$@" ;;
    link)           cmd_link ;;
    sim)            cmd_sim "$@" ;;
    view|display)   cmd_view "$@" ;;
    demo)           cmd_demo "$@" ;;
    drive)          cmd_drive "$@" ;;
    teleop)         cmd_teleop ;;
    stop)           cmd_stop ;;
    arm)            cmd_arm "$@" ;;
    grip|gripper)   cmd_grip "$@" ;;
    pr)             cmd_pr "$@" ;;
    status)         cmd_status ;;
    topics)         cmd_topics "$@" ;;
    shell)          cmd_shell ;;
    *)              die "Unknown command '$cmd' — see 'scout help'." ;;
esac
