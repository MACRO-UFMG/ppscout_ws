<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="piper_arm_joint" params="joint_name">
        <joint name="${joint_name}">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <ros2_control name="PiperArmSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <xacro:piper_arm_joint joint_name="joint1"/>
        <xacro:piper_arm_joint joint_name="joint2"/>
        <xacro:piper_arm_joint joint_name="joint3"/>
        <xacro:piper_arm_joint joint_name="joint4"/>
        <xacro:piper_arm_joint joint_name="joint5"/>
        <xacro:piper_arm_joint joint_name="joint6"/>
        <joint name="gripper">
            <command_interface name="position"/>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find ppscout_ros2)/params/arm_controllers.yaml</parameters>
            <controller_manager_prefix_node_name>controller_manager</controller_manager_prefix_node_name>
        </plugin>
    </gazebo>

</robot>
